# Copy to .env if you want to override defaults.
RTFAAS_TOKEN=rtfaas-dev-token
# Default (no Docker / no Postgres): SQLite file next to the backend.
DATABASE_URL=sqlite+aiosqlite:///./data/rtfaas.db
# Optional Postgres (Docker Compose):
# DATABASE_URL=postgresql+asyncpg://rtfaas:rtfaas@localhost:5432/rtfaas
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SIMULATOR_TPS=2
